{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/algoritmo-da-lideranca", "destination": "/" },
    { "source": "/arquitetura-de-vendas", "destination": "https://arquitetura-vendas-checkout.vercel.app/arquitetura-de-vendas" },
    { "source": "/arquitetura-de-vendas/:path*", "destination": "https://arquitetura-vendas-checkout.vercel.app/arquitetura-de-vendas/:path*" }
  ],
  "headers": [
    {
      "source": "/((?!arquitetura-de-vendas).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://agconsultorialtda.com https://www.agconsultorialtda.com" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
